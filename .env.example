# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev_assessment_db?schema=public"

# Better Auth Configuration
# Secret should be minimum 32 characters (e.g. generated via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="dev-insecure-secret-change-in-production-min-32-chars-key"
BETTER_AUTH_URL="http://localhost:5000"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
